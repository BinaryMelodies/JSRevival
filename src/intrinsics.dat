# Every object has a type, the supported types are:
#	U undefined
#	O object (or null)
#	F function
#	C constructor (also a JavaScript function)
#	B boolean
#	N number
#	S string
#	Z symbol
#	I bigint
#	* an internal value or record (in global scope: a name in the intrinsics object that evaluates to an alias)
#	T an internal type, exotic object layout
#	A accessor (a property type)
#	> the layout of the returned type (only for functions)
#	: the C++ type for objects of this layout
#	= the C++ type for the ES4 class object
# Objects appearing as data properties can have attributes (added via "+" or "-" and an identifier) and their name is listed as a "string" or [Symbol.reference]
# Attributes supported include: Writable, Enumerable, Configurable (deletable), ECMAScript 4: Instance property for class instances, Final (only for instance properties)
# All entities can then be followed by ":=" and an initial value specification
# Functions (including constructors) are followed by an optional "=" and function name, then "/" and a length count
# All objects (including functions, constructors) can specify their prototype via ":"
# ECMAScript 4 constructors (classes) can specify their superclass via "<:"
# All objects can have attributes attached
# The "=:" operator declares the entry as a globally identifiable name (used internally); if the property name is a literal identifier, that will also create a globally identifiable name
# Objects with "{" and "}" at their end have a special object layout (identified as a constructor or internal type)
# Arguments to the object constructor can be provided between '("' and '")'
# ECMASCript 4 objects with "<" and ">" at their end use that value as the static type of the property field
# lines starting with "~" signal an alternative definition for other versions

%define	NativeError	NativeError
6	C	{NativeError}/1 : Error <: Error
~1!6	C	{NativeError}/1 <: Error
4		=		"JS::Runtime::Builtin::ErrorSubClass"("{NativeError}", {NativeError}.prototype)
1		O	-W-E-C+I	"prototype" : Error.prototype <Object>
1			C			"constructor" := {NativeError}
1			S	+W-E-C	"message" := ""
1			S	+W-E-C	"name" := "{NativeError}"
%end	NativeError

%define	TypedArray	TypedArray	Type	BYTES_PER_ELEMENT
6	C	{TypedArray}/3 : TypedArray {{TypedArrayConstructor("&realm, JS::Class::TypedArray::ElementType::{Type}, &Intrinsics::{TypedArray}_prototype") }}
7		N	-W-E-C	"BYTES_PER_ELEMENT" := {BYTES_PER_ELEMENT}
6		O	-W-E-C	"prototype" : TypedArray.prototype
6			N	-W-E-C	"BYTES_PER_ELEMENT" := {BYTES_PER_ELEMENT}
6			C		"constructor" := {TypedArray}
%end

%define	IntegerClass	IntegerClass	MIN_VALUE	MAX_VALUE
4	C	{IntegerClass}/1 <: GeneralNumber
4		=		"JS::Runtime::Builtin::IntegerClass"("{IntegerClass}", {MIN_VALUE} <int> , {MAX_VALUE} <int> )
4		O	-W-E-C+I	"prototype" := GeneralNumber.prototype
4		N		"MAX_VALUE" := {MIN_VALUE} <Number>
4		N		"MIN_VALUE" := {MAX_VALUE} <Number>
%end

