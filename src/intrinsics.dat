# ES4.2008: singleton object of helper class Math, Math.[[Prototype]] has no constructor property, Math.constructor is defined
4	C		MathClass/1
1		:		"JS::Class::Singleton"
4		=		"JS::Runtime::Builtin::SingletonClass"("Math", MathPrototype)
# to make sure Math object has the prototype Object.prototype
4	O		MathPrototype
1!4	*		Math_prototype := Object.prototype <JSObject>
~4	*		Math_prototype := MathPrototype <JSObject>
6	T		ModuleNamespace
6		S	-W-E-C	[Symbol.toStringTag] := "Module"
6!8		F		[Symbol.iterator] = "[Symbol.iterator]"/0
